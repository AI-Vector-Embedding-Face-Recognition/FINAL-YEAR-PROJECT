# FaceVector Attendance - environment variables
#
# THIS PROJECT NEEDS NO ENVIRONMENT VARIABLES AND NO SECRETS.
# It is a static, browser-only site (HTML/CSS/JS + localStorage) with no backend, and the
# FaceVector AI assistant runs 100% locally in the browser. There is no API key anywhere.
#
# Never put real secrets in this file or in any file served to the browser.
# If you later add a server-side AI proxy (see ASSISTANT.md, "Connecting an AI provider"),
# these are the variables such a server would read. They are NOT used by the current code.
#
# AI_PROVIDER_API_KEY=            # server only. Never expose to frontend JavaScript.
# AI_PROVIDER_BASE_URL=           # e.g. your provider's HTTPS endpoint
# AI_MODEL=                       # model name from your provider
# SESSION_SECRET=                 # long random string for signing server sessions
# ALLOWED_ORIGIN=https://your-site.example   # restrictive CORS origin
# RATE_LIMIT_AI_PER_MINUTE=10
# RATE_LIMIT_LOGIN_PER_15_MIN=5
